{% extends 'base.html.twig' %}

{% block title %}Measurement{% endblock %}

{% block body %}
    <h1 class="h3">Forecast</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ measurement.id }}</td>
            </tr>
            <tr>
                <th>Location</th>
                <td>{{ measurement.location.city }} ({{ measurement.location.country }})</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Celsius</th>
                <td>{{ measurement.celsius }} &deg;C</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <a href="{{ path('app_measurement_index') }}" class="btn btn-outline-secondary">back to list</a>
        <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}" class="btn btn-primary">edit</a>
        {{ include('measurement/_delete_form.html.twig') }}
    </div>
{% endblock %}
