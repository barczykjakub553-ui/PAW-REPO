{% extends 'base.html.twig' %}

{% block title %}Measurement index{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Forecasts</h1>
        <a href="{{ path('app_measurement_new') }}" class="btn btn-primary">Create new</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Location</th>
                    <th>Date</th>
                    <th>Celsius</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for measurement in measurements %}
                <tr>
                    <td>{{ measurement.id }}</td>
                    <td>{{ measurement.location.city }} ({{ measurement.location.country }})</td>
                    <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
                    <td>{{ measurement.celsius }} &deg;C</td>
                    <td class="text-nowrap">
                        <a href="{{ path('app_measurement_show', {'id': measurement.id}) }}" class="btn btn-sm btn-outline-secondary">show</a>
                        <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}" class="btn btn-sm btn-outline-primary">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
